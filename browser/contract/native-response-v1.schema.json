{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dk-desktop-essentials.invalid/schemas/browser-native-response-v1.json",
  "title": "DK Browser Native Messaging Response v1",
  "description": "Safe, redacted native response. Never return URL, cookies, request headers or absolute filesystem paths to a browser extension.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "id", "ok", "result", "error"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/requestId" },
    "ok": { "type": "boolean" },
    "result": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ready", "capabilities"],
          "properties": {
            "ready": { "const": true },
            "capabilities": {
              "type": "object",
              "additionalProperties": false,
              "required": ["manualOffer", "automaticHandoff"],
              "properties": {
                "manualOffer": { "type": "boolean" },
                "automaticHandoff": { "const": false }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["accepted", "jobId", "state"],
          "properties": {
            "accepted": { "const": true },
            "jobId": { "$ref": "#/$defs/requestId" },
            "state": { "const": "Queued" }
          }
        }
      ]
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "enum": [
                "HOST_UNAVAILABLE", "NOT_READY", "PROTOCOL_UNSUPPORTED",
                "INVALID_MESSAGE", "UNSUPPORTED_URL", "USER_DECLINED",
                "CONFIRMATION_REQUIRED", "RATE_LIMITED", "PERMISSION_DENIED",
                "QUEUE_UNAVAILABLE", "REQUEST_EXPIRED", "NATIVE_ERROR"
              ]
            },
            "message": { "type": "string", "maxLength": 256, "description": "Safe generic message, never a raw exception or URL." }
          }
        }
      ]
    }
  },
  "$defs": {
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    }
  },
  "allOf": [
    { "if": { "properties": { "ok": { "const": true } }, "required": ["ok"] },
      "then": { "properties": { "error": { "type": "null" }, "result": { "not": { "type": "null" } } } } },
    { "if": { "properties": { "ok": { "const": false } }, "required": ["ok"] },
      "then": { "properties": { "result": { "type": "null" }, "error": { "not": { "type": "null" } } } } }
  ]
}
