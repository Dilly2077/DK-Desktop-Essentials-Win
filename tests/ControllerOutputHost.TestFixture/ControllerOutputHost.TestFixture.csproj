<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DKControllerOutputHost.TestFixture</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/DKControllerOutputHost/Program.cs" Link="Program.cs" />
    <Compile Include="../../src/DKControllerOutputHost/OutputProtocol.cs" Link="OutputProtocol.cs" />
    <Compile Include="../../src/Shared/ProviderIntegrity.cs" Link="ProviderIntegrity.cs" />
    <Compile Include="../../src/Shared/PrivilegedProviderEnvironment.cs" Link="PrivilegedProviderEnvironment.cs" />
    <Compile Include="$(FixturePinsPath)" Link="ProviderPins.Generated.cs" />
  </ItemGroup>
  <Target Name="RequireFixturePins" BeforeTargets="BeforeBuild">
    <Error Condition="'$(FixturePinsPath)' == '' Or !Exists('$(FixturePinsPath)')" Text="Build this test-only helper through scripts/Test-ControllerHub.ps1." />
  </Target>
</Project>
